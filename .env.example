# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# TMDB (client-safe, read-only)
VITE_TMDB_API_KEY=your_tmdb_api_key

# Google Calendar OAuth
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# --- NEVER PUT THESE IN CLIENT CODE ---
# These go in Supabase Edge Function secrets (Supabase Vault), not here.
# Listed here only so you know they must be configured in the dashboard.
#
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
# GAMES_SUPABASE_URL=
# GAMES_SUPABASE_SERVICE_KEY=
# GOOGLE_CALENDAR_CLIENT_SECRET=
