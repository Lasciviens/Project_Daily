# ─── Supabase ────────────────────────────────────────────────
# Safe to expose in client code ONLY because all tables have RLS enabled.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── TMDB ─────────────────────────────────────────────────────
# Read-only API key — safe in client code.
VITE_TMDB_API_KEY=your_tmdb_api_key

# ─── Google Calendar OAuth ────────────────────────────────────
# Client ID is public. Client secret MUST stay in Edge Function secrets.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ─────────────────────────────────────────────────────────────
# NEVER PUT THE FOLLOWING IN CLIENT CODE OR COMMIT THEM.
# These belong in Supabase Edge Function secrets (Supabase Vault).
# They are listed here only so you know they must be configured
# in the Supabase dashboard under Settings → Edge Functions → Secrets.
#
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GAMES_SUPABASE_URL=          (RP5 project URL)
# GAMES_SUPABASE_SERVICE_KEY=  (RP5 service role key — bypasses RLS on that project)
# ─────────────────────────────────────────────────────────────
