# Every environment variable the code reads — names only, never a value.
# What each one is for and where it is set: docs/backend/environment.md.

# ─── Website ──────────────────────────────────────────────────────────────
# Copy these lines into .env.local and fill them in. They are baked into the
# build, so only keys that are public by design belong here.

# Required: the main Supabase project and its publishable key (sb_publishable_…).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The legacy anon key, read only while the publishable key is empty — until the
# old Supabase keys are switched off.
# VITE_SUPABASE_ANON_KEY=

# Optional: each one turns its feature on.
# TMDB (Media)
VITE_TMDB_API_KEY=
# Google OAuth client id (Calendar, Tasks, Health consent)
VITE_GOOGLE_CLIENT_ID=
# Strava OAuth client id (Connect Strava)
VITE_STRAVA_CLIENT_ID=
# Open Exchange Rates (Home's currency widget)
VITE_OXR_APP_ID=
# Web Push: the VAPID public key
VITE_VAPID_PUBLIC_KEY=

# ─── Server only ──────────────────────────────────────────────────────────
# Supabase Edge Function secrets (a cron job reads its own from Vault too).
# NEVER in .env.local, client code or a commit.
#
# AI (ai-proxy)
# GEMINI_API_KEY=
# Google OAuth, and the Google Tasks sync cron
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TASKS_SYNC_SECRET=
# Strava
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Hevy: API key, webhook secret, and the one user every server path acts as
# HEVY_API_KEY=
# HEVY_WEBHOOK_SECRET=
# HEVY_USER_ID=
# Health Auto Export webhook
# HEALTH_EXPORT_WEBHOOK_SECRET=
# Food search (kassal.app)
# KASSALAPP_API_KEY=
# iPhone: phone-gateway and ai-proxy's phone branch
# PHONE_GATEWAY_SECRET=
# Web Push (push-send) and its morning cron
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# PUSH_CRON_SECRET=
# ScreenScraper: the developer pair and the member pair (all four needed);
# the media key (optional) signs screenscraper-media links
# SCREENSCRAPER_DEVID=
# SCREENSCRAPER_DEVPASSWORD=
# SCREENSCRAPER_SSID=
# SCREENSCRAPER_SSPASSWORD=
# SCREENSCRAPER_MEDIA_KEY=
# ES-DE handheld (esde-sync, esde-media-sync, esde-content-sync)
# ESDE_SYNC_SECRET=
# Trakt (trakt-api and its cron), with TMDB and MDBList lookups
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# TRAKT_SYNC_SECRET=
# TMDB_API_KEY=
# MDBLIST_API_KEY=
# Kobo: the Send to Kobo catalogue token and the plugin's device secret
# KOBO_OPDS_TOKEN=
# KOBO_SYNC_SECRET=
# IGDB (a Twitch developer app)
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# iCloud calendars: the cron's secret and the key that seals the stored password
# ICLOUD_SYNC_SECRET=
# ICLOUD_ENC_KEY=
# Shop prices and rates sweep (cron)
# SHOP_PRICE_CRON_SECRET=
# Steam
# STEAM_API_KEY=
# STEAM_ID64=
#
# Set by Supabase in every function — never set them yourself: SUPABASE_URL,
# SUPABASE_SECRET_KEYS, SUPABASE_PUBLISHABLE_KEYS and the legacy
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY.
#
# The deploy's own secrets (GitHub environment "production"):
# SUPABASE_ACCESS_TOKEN, SUPABASE_DB_URL — docs/deploy-setup.md.
